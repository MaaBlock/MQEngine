namespace MQEngine.FlatBuffers;

struct Vec3f {
    x: float;
    y: float;
    z: float;
}

table MeshInfo {
    name: string;
    vertex_count: uint32;
    index_count: uint32;
    triangle_count: uint32;
    is_indexed: bool;
    has_positions: bool;
    has_normals: bool;
    has_tangents: bool;
    has_bitangents: bool;
    has_tex_coords: [bool];
    has_vertex_colors: [bool];
    bounding_box_min: Vec3f;
    bounding_box_max: Vec3f;
    bounding_box_center: Vec3f;
    has_bones: bool;
    bone_count: uint32;
}

table MaterialInfo {
}

table TextureInfo {
    path: string;
    is_inner: bool;
    types: [int32];
}

table SceneInfo {
    name: string;
    mesh_infos: [MeshInfo];
    material_infos: [MaterialInfo];
    texture_infos: [TextureInfo];
    animation_names: [string];
    bone_count: uint32;
}

table ModelTimestamp {
    timestamp: int64;
    source_path: string;
}

root_type SceneInfo;
file_identifier "MQMI";
