{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "mqengine": ["./node_modules/mqengine/index.d.ts"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./node_modules/mqengine/index.d.ts"
  ]
}
