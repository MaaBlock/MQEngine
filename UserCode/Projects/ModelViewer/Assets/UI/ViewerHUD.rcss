/* ==============================================================================
   MQEngine ModelViewer - ViewerHUD.rcss
   现代深色半透明 HUD 样式表 (Dear Dark Slate / Glassmorphism)
   ============================================================================== */

body.viewer-body {
    font-family: Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    color: #e2e8f0;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: transparent;
}

/* 顶部常驻快捷状态栏 */
.top-nav-bar {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 48px;
    background-color: #14161ae6;
    border-bottom: 1px solid #282f3d;
    box-sizing: border-box;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 8px;
    z-index: 100;
}

.nav-brand {
    display: inline-block;
    float: left;
    margin-top: 2px;
}

.brand-title {
    font-size: 18px;
    font-weight: bold;
    color: #38bdf8;
    margin-right: 8px;
}

.brand-subtitle {
    font-size: 13px;
    font-weight: 500;
    color: #94a3b8;
}

.nav-stats {
    display: inline-block;
    float: left;
    margin-left: 40px;
    margin-top: 4px;
}

.fps-badge {
    font-size: 12px;
    font-weight: bold;
    color: #10b981;
    background-color: #064e3b88;
    border: 1px solid #059669;
    border-radius: 4px;
    padding: 3px 10px;
}

.nav-actions {
    display: inline-block;
    float: right;
}

/* 半透明深色 HUD 卡片容器 */
.hud-card {
    display: block;
    position: absolute;
    background-color: #1a1e26eb;
    border: 1px solid #2e3748;
    border-radius: 8px;
    box-shadow: 0 8px 24px #00000088;
    box-sizing: border-box;
    padding: 14px 16px;
    z-index: 50;
}

/* 左上方模型信息卡片 */
.card-top-left {
    top: 64px;
    left: 20px;
    width: 330px;
}

/* 右上方后处理与控制卡片 */
.card-top-right {
    top: 64px;
    right: 20px;
    width: 350px;
    max-height: 85%;
    overflow-y: auto;
}

/* 底部视角工具栏 */
.card-bottom-center {
    bottom: 24px;
    left: 50%;
    margin-left: -240px;
    width: 480px;
    text-align: center;
    padding: 10px 16px;
}

/* 卡片头部 */
.card-header {
    display: block;
    border-bottom: 1px solid #2d3647;
    padding-bottom: 8px;
    margin-bottom: 12px;
}

.card-title {
    font-size: 14px;
    font-weight: bold;
    color: #f1f5f9;
}

.status-badge {
    float: right;
    font-size: 10px;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 3px;
}

.badge-ready {
    background-color: #065f46;
    color: #34d399;
    border: 1px solid #10b981;
}

.badge-loading {
    background-color: #78350f;
    color: #fbbf24;
    border: 1px solid #f59e0b;
}

/* 信息键值行 */
.card-content {
    display: block;
}

.info-row {
    display: block;
    margin-bottom: 8px;
    line-height: 18px;
}

.info-label {
    display: inline-block;
    width: 95px;
    color: #94a3b8;
    font-size: 12px;
}

.info-value {
    display: inline-block;
    color: #f8fafc;
    font-weight: 500;
    font-size: 12px;
}

.path-value {
    color: #38bdf8;
    word-break: break-all;
}

/* 控制区块 */
.control-section {
    display: block;
    border-top: 1px solid #283140;
    padding-top: 10px;
    margin-top: 10px;
}

.section-label {
    display: block;
    font-size: 12px;
    font-weight: bold;
    color: #cbd5e1;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* 按钮规范 */
.hud-btn {
    display: inline-block;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    border-radius: 4px;
    cursor: pointer;
    text-align: center;
    border: 1px solid transparent;
}

.hud-btn-primary {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #3b82f6;
}

.hud-btn-primary:hover {
    background-color: #3b82f6;
    border-color: #60a5fa;
}

.hud-btn-primary:active {
    background-color: #1d4ed8;
}

.hud-btn-secondary {
    background-color: #242a36;
    color: #cbd5e1;
    border-color: #3b4455;
    margin-left: 4px;
    margin-right: 4px;
}

.hud-btn-secondary:hover {
    background-color: #333c4d;
    color: #ffffff;
    border-color: #4b5563;
}

.hud-btn-secondary:active {
    background-color: #1e232d;
}

/* 下拉框 */
.hud-select {
    display: block;
    width: 100%;
    padding: 6px 10px;
    font-size: 12px;
    background-color: #202632;
    color: #f1f5f9;
    border: 1px solid #3b4659;
    border-radius: 4px;
    box-sizing: border-box;
    margin-bottom: 8px;
}

.hud-select:hover {
    border-color: #60a5fa;
}

/* 复选框行 */
.toggle-row {
    display: block;
    margin-bottom: 8px;
    padding-top: 2px;
}

.hud-checkbox {
    vertical-align: middle;
    margin-right: 8px;
}

.toggle-label {
    vertical-align: middle;
    color: #e2e8f0;
    font-size: 12px;
    cursor: pointer;
}

/* 滑块行 */
.slider-row {
    display: block;
    margin-bottom: 8px;
    padding-left: 18px;
}

.slider-title {
    display: inline-block;
    width: 110px;
    font-size: 11px;
    color: #94a3b8;
}

.hud-slider {
    display: inline-block;
    width: 120px;
    vertical-align: middle;
}

.slider-val {
    display: inline-block;
    width: 50px;
    text-align: right;
    font-size: 11px;
    font-weight: bold;
    color: #38bdf8;
    vertical-align: middle;
}

/* 未载入模型时的中心拖拽引导提示 */
.empty-prompt-card {
    display: block;
    position: absolute;
    top: 45%;
    left: 50%;
    margin-left: -220px;
    margin-top: -80px;
    width: 440px;
    padding: 24px;
    background-color: #161a22cc;
    border: 2px dashed #3b475a;
    border-radius: 12px;
    text-align: center;
    box-sizing: border-box;
    z-index: 10;
}

.prompt-icon {
    font-size: 32px;
    color: #38bdf8;
    margin-bottom: 10px;
}

.prompt-title {
    font-size: 16px;
    font-weight: bold;
    color: #f8fafc;
    margin-bottom: 6px;
}

.prompt-desc {
    font-size: 12px;
    color: #94a3b8;
    line-height: 18px;
}
