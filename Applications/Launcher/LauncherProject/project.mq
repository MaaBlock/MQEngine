# MQEngine 启动器工程配置文件
projectName = "LauncherProject"
version = "1.0.0"
assetRoot = "Assets"
pipelinePath = "Assets/Pipelines/default_pipeline.json"
plugins = ["RmlUiPlugin", "HtmlGameUiPlugin"]
userCodes = ["LauncherNative"]
initialSceneUuid = "default-scene-0001-0000-000000000001"

[settings]
description = "MQEngine 启动器专属工程"
